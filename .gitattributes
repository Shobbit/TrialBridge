# Normalise line endings so the repo is identical on Windows, macOS and Linux
# (and so CI diffs stay clean).
* text=auto eol=lf

# Binary files must never be normalised.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary

# Keep generated lockfile diffs out of code review.
package-lock.json linguist-generated=true
